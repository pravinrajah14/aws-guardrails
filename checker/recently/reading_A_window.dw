// "Don't deploy to production if the tests failed recently."
// Reading A: "recently" = a fixed window. ANY failing run on this commit in
// the last hour blocks the deploy, even if a later run passed.
@id("deploy_allowed")
permit (principal, action == Shop::Action::"Deploy", resource);

@id("no_deploy_after_recent_failure")
forbid (principal, action == Shop::Action::"Deploy", resource)
when { context.input.env == "prod" }
when temporal {
    formerly within 1h Shop::Action::"RunTests"::response{
        input.commit: context.input.commit,
        output.passed: false,
        output.coverage: _
    }
};
