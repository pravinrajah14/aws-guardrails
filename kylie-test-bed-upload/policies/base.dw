// Base permissions the store always loads. Read-only and low-risk tools are allowed.
// The rule file under test is added after these (see run_task.py --rules).
// Deny by default: anything not permitted here or in the rule file is blocked.

@id("allow_lookup")
permit ( principal, action == Shop::Action::"LookupOrder", resource );

@id("allow_approval_requests")
permit ( principal, action == Shop::Action::"RequestApproval", resource );

@id("allow_tests")
permit ( principal, action == Shop::Action::"RunTests", resource );

@id("allow_rollback")
permit ( principal, action == Shop::Action::"Rollback", resource );

// Store-wide invariant, whatever rule file is loaded: never refund more than the order total in all,
// counting every completed refund on the order under any approval. The context engine attaches these
// facts on every refund request whose order is in the store; with no facts this rule does not apply.
@id("refund_within_order_total")
forbid ( principal, action == Shop::Action::"IssueRefund", resource )
when {
    context has facts &&
    context.facts has order_total &&
    context.facts has refunded_on_order &&
    context.input.amount + context.facts.refunded_on_order > context.facts.order_total
};
