// Read-only and low-risk tools are always allowed.

@id("allow_lookup")
permit ( principal, action == Shop::Action::"LookupOrder", resource );

@id("allow_approval_requests")
permit ( principal, action == Shop::Action::"RequestApproval", resource );

@id("allow_tests")
permit ( principal, action == Shop::Action::"RunTests", resource );

@id("allow_rollback")
permit ( principal, action == Shop::Action::"Rollback", resource );

// Under any rule file, never refund more than the order total in all; with no facts this rule does not apply.
@id("refund_within_order_total")
forbid ( principal, action == Shop::Action::"IssueRefund", resource )
when {
    context has facts &&
    context.facts has order_total &&
    context.facts has refunded_on_order &&
    context.input.amount + context.facts.refunded_on_order > context.facts.order_total
};

// Under any rule file, block the refund when the store's records disagree; a person reviews.
@id("refund_blocked_on_conflict")
forbid ( principal, action == Shop::Action::"IssueRefund", resource )
when { context has facts && context.facts.status == "conflict" };
