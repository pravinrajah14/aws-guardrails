          "tool": "request_approval",
          "kind": "response",
          "input": {
            "order_id": "A100",
            "amount": 20,
            "reason": "damaged on arrival"
          },
          "output": {
            "approved": true,
            "approver": "manager.jordan",
            "approved_amount": 20
          }
        },
        {
          "at": "5m",
          "tool": "request_approval",
          "kind": "response",
          "input": {
            "order_id": "A100",
            "amount": 40,
            "reason": "damaged on arrival"
          },
          "output": {
            "approved": true,
            "approver": "manager.jordan",
            "approved_amount": 40
          }
        },
        {
          "at": "10m",
          "tool": "issue_refund",
          "input": {
            "order_id": "A100",
            "amount": 20
          },
          "expect": "DENY",
          "expect_status": "conflict"
