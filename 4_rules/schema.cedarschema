// Action schema for the Foundations test environment (refund + deploy mock tools).
// One action per mock tool. Shapes follow dogwood-docs/examples/*/schema.cedarschema.
// ASSUMPTION: field names/types here are Jack's draft; Kylie's mock tools must
// expose the same fields (especially order_age_days, customer_id, approver_role).
namespace Ops {
  // ---- Refund tools ----
  type RefundInput = {
    order_id: String,
    customer_id: String,
    amount: Long,
    order_age_days: Long
  };
  type RefundOutput = {
    status: String
  };

  type ApproveRefundInput = {
    order_id: String,
    amount: Long
  };
  type ApproveRefundOutput = {
    approved: Bool,
    approver_role: String
  };

  // ---- Deploy tools ----
  type DeployInput = {
    service: String,
    version: String,
    env: String
  };
  type DeployOutput = {
    status: String
  };

  type RunTestsInput = {
    service: String,
    version: String
  };
  type RunTestsOutput = {
    passed: Bool
  };

  type ApproveDeployInput = {
    service: String,
    version: String,
    env: String
  };
  type ApproveDeployOutput = {
    approved: Bool
  };

  type RollbackInput = {
    service: String,
    env: String
  };
  type RollbackOutput = {
    status: String
  };

  type SystemContext = {
    now: datetime
  };

  entity Gateway;

  entity OAuthUser = {
    id: String
  } tags String;

  action "Refund" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: RefundInput, output?: RefundOutput, system: SystemContext }
  };

  action "ApproveRefund" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: ApproveRefundInput, output?: ApproveRefundOutput, system: SystemContext }
  };

  action "Deploy" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: DeployInput, output?: DeployOutput, system: SystemContext }
  };

  action "RunTests" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: RunTestsInput, output?: RunTestsOutput, system: SystemContext }
  };

  action "ApproveDeploy" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: ApproveDeployInput, output?: ApproveDeployOutput, system: SystemContext }
  };

  action "Rollback" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: RollbackInput, output?: RollbackOutput, system: SystemContext }
  };
}
