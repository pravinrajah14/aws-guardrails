{
  "sentence": "Refund up to $40 for order A100, subject to approval.",
  "status": "ready",
  "source": "the sentence; the 1h window follows R4 in 4_rules/policies.dw, the only approval rule that states one",
  "forms": [
    {
      "id": "reference_limit",
      "action": "IssueRefund",
      "kind": "limit",
      "field": "amount",
      "max": 40,
      "op": ">",
      "only_when": {
        "field": "order_id",
        "op": "==",
        "value": "A100"
      }
    },
    {
      "id": "reference_approval",
      "action": "IssueRefund",
      "kind": "requires_prior",
      "only_when": {
        "field": "order_id",
        "op": "==",
        "value": "A100"
      },
      "requires": {
        "action": "RequestApproval",
        "within": "1h",
        "same": [
          "order_id"
        ],
        "output": {
          "approved": true
        },
        "at_most": {
          "amount": "approved_amount"
        },
        "spent_so_far": {
          "amount": "refunded_so_far"
        },
        "approver_role": "manager"
      }
    }
  ]
}
