// GENERATED by converter/convert.py from rule forms. Do not edit by hand.
// Baseline: actions no requires_prior rule gates are always allowed.
@id("allow_lookup_order")
permit (principal, action == Shop::Action::"LookupOrder", resource);
@id("allow_request_approval")
permit (principal, action == Shop::Action::"RequestApproval", resource);
@id("allow_run_tests")
permit (principal, action == Shop::Action::"RunTests", resource);
@id("allow_rollback")
permit (principal, action == Shop::Action::"Rollback", resource);

// Only refund if a manager approved it recently.
@id("refund_needs_manager_approval")
permit (principal, action == Shop::Action::"IssueRefund", resource)
when {
    context has facts &&
    context.facts.status == "ok" &&
    context.facts has approved_amount &&
    context.input.amount <= context.facts.approved_amount &&
    context.facts has approver_role &&
    context.facts.approver_role == "manager"
}
when temporal {
    formerly within 1h Shop::Action::"RequestApproval"::response{
        input.order_id: context.input.order_id,
        output.approved: true
    }
};

// Production deploys are only allowed for payments, search and web.
@id("prod_deploy_allowlist")
forbid (principal, action == Shop::Action::"DeployService", resource)
when { context.input.env == "prod" && !(["payments", "search", "web"].contains(context.input.service)) };

// A version may only go to production if its tests passed within the last 24 hours.
@id("prod_deploy_needs_passing_tests_not_applicable")
permit (principal, action == Shop::Action::"DeployService", resource)
when { !(context.input.env == "prod") };

@id("prod_deploy_needs_passing_tests")
permit (principal, action == Shop::Action::"DeployService", resource)
when { context.input.env == "prod" }
when temporal {
    formerly within 24h Shop::Action::"RunTests"::response{
        input.service: context.input.service,
        input.version: context.input.version,
        output.passed: true
    }
};

// A single refund may not exceed $500.
@id("refund_max_500")
forbid (principal, action == Shop::Action::"IssueRefund", resource)
when { context.input.amount > 500 };
